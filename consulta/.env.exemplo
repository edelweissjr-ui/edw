# ===== Copiloto Weiss — variáveis da plataforma =====
# Copie para .env (ou cadastre no painel da hospedagem). Nunca envie o .env para o GitHub.

# Senha que a equipe digita para entrar
SENHA_ACESSO=troque-por-uma-senha-forte
# Texto aleatório longo (assina o login). Se ficar vazio, todos precisam entrar de novo a cada reinício.
SEGREDO_SESSAO=

# --- Kommo ---
# subdomínio: a parte antes de .kommo.com (ex.: odontoweiss)
KOMMO_SUBDOMINIO=
# token de longa duração da integração privada (Configurações > Integrações)
KOMMO_TOKEN=
# opcionais: funil e etapas (IDs numéricos). 142 = venda ganha, 143 = venda perdida
KOMMO_FUNIL_ID=
KOMMO_ETAPA_NEGOCIACAO=
KOMMO_ETAPA_FECHADO=142
KOMMO_ETAPA_PERDIDO=143
KOMMO_RESPONSAVEL_ID=
# chave secreta que vai no endereço do webhook de mensagens (WhatsApp ao vivo)
KOMMO_CHAVE_WEBHOOK=

# --- IA (Claude) ---
ANTHROPIC_API_KEY=
# MODELO_IA=claude-opus-5-5

# --- Transcrição de áudio (opcional) ---
OPENAI_API_KEY=

# Pasta onde ficam as mensagens recebidas do Kommo (use um disco persistente)
PASTA_DADOS=./dados
PORT=3000
