# ===== Alinha — configurações =====
# Usuário "equipe": uso diário · Usuário "admin": acesso total (configurações, apagar dados, cópias)
SENHA_ACESSO=troque-por-uma-senha-forte
SENHA_ADMIN=troque-por-outra-senha-forte
# opcional: se vazio, é derivado das senhas
SEGREDO_SESSAO=
ANTHROPIC_API_KEY=
# MODELO_IA=claude-opus-5-5
# Dicas ao vivo com um modelo mais rápido e barato (opcional):
# MODELO_DICAS=claude-haiku-5-5
PASTA_DADOS=./dados
# Vercel (ou sem disco): dados no Upstash Redis — preenchidas sozinhas ao conectar o Upstash na Vercel
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
PORT=3000
# Opcional — enviar o briefing ao Kommo
KOMMO_SUBDOMINIO=edelweissjrhotmailcom
KOMMO_TOKEN=
# Chave secreta do webhook de mensagens (WhatsApp ao vivo): https://SEU-ENDERECO/webhooks/kommo/ESTA_CHAVE
KOMMO_CHAVE_WEBHOOK=

# Opcional — Conectar celular por QR code (Evolution API, conexão não oficial)
EVOLUTION_URL=
EVOLUTION_API_KEY=
# EVOLUTION_INSTANCIA=alinha
